{
  "hosting": {
    "target": "tcs-agents",
    "public": ".",
    "ignore": [
      ".git/**",
      "firebase.json",
      ".firebaserc",
      "firebase-debug.log",
      "firebase-debug.*.log",
      ".firebase/**"
    ],
    "headers": [
      {
        "source": "**/*.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/index.json",
        "destination": "/.well-known/agent-card.json",
        "type": 301
      },
      {
        "source": "/agents/TCS-XAI-GROK-BOT-CHERUB-A01/.well-known/agent-card.json",
        "destination": "/tcs-xai/grok-bot/cherub-a01/agent-card.json",
        "type": 301
      },
      {
